#!/usr/bin/env bash
set -euo pipefail

# Builds statically-linked ast-grep binaries for one or more targets.
# Targets are auto-detected from the host OS/arch, or passed explicitly.
#
# Usage:
#   bin/build-static                        # build for current platform
#   bin/build-static --all                  # build all targets feasible on this host
#   bin/build-static x86_64-unknown-linux-musl aarch64-unknown-linux-musl

REPO_ROOT="$(cd "${BASH_SOURCE[0]%/*}/.." && pwd)"
AST_GREP_DIR="$REPO_ROOT/ast-grep"

# Non-interactive mode: --yes / -y flag, or any CI environment
ASSUME_YES="${ASSUME_YES:-${CI:+1}}"

# aarch64 musl cross toolchain — a glibc cross-gcc cannot produce fully static
# musl binaries, and cargo also needs an explicit target linker
MUSL_CROSS_BASE_URL="${MUSL_CROSS_BASE_URL:-https://musl.cc}"
MUSL_CROSS_NAME=aarch64-linux-musl-cross
MUSL_CROSS_GCC=aarch64-linux-musl-gcc
TOOLCHAIN_DIR="${TOOLCHAIN_DIR:-$REPO_ROOT/.toolchains}"

# Let rustc strip every target itself — host strip can't handle cross-arch binaries
export CARGO_PROFILE_RELEASE_STRIP="${CARGO_PROFILE_RELEASE_STRIP:-symbols}"

apt_install() {
  [[ -n "${APT_UPDATED:-}" ]] || { sudo apt-get update -qq; APT_UPDATED=1; }
  sudo apt-get install ${ASSUME_YES:+-y} "$@"
}

# Supported release targets
LINUX_X86=x86_64-unknown-linux-musl
LINUX_ARM=aarch64-unknown-linux-musl
MACOS_X86=x86_64-apple-darwin
MACOS_ARM=aarch64-apple-darwin
WINDOWS_X86=x86_64-pc-windows-msvc

ALL_TARGETS=("$LINUX_X86" "$LINUX_ARM" "$MACOS_X86" "$MACOS_ARM" "$WINDOWS_X86")

HOST_OS="$(uname -s)"
HOST_ARCH="$(uname -m)"

# Map host to native target triple
native_target() {
  case "$HOST_OS" in
    Linux)
      case "$HOST_ARCH" in
        x86_64)  echo "$LINUX_X86" ;;
        aarch64) echo "$LINUX_ARM" ;;
        *)       echo "unsupported arch: $HOST_ARCH" >&2; return 1 ;;
      esac
      ;;
    Darwin)
      case "$HOST_ARCH" in
        x86_64)  echo "$MACOS_X86" ;;
        arm64)   echo "$MACOS_ARM" ;;
        *)       echo "unsupported arch: $HOST_ARCH" >&2; return 1 ;;
      esac
      ;;
    MINGW*|MSYS*|CYGWIN*)
      echo "$WINDOWS_X86"
      ;;
    *)
      echo "unsupported OS: $HOST_OS" >&2; return 1
      ;;
  esac
}

# Targets feasible on this host without a full cross-compilation toolchain
feasible_targets() {
  case "$HOST_OS" in
    Linux)
      echo "$LINUX_X86"
      echo "$LINUX_ARM"
      ;;
    Darwin)
      echo "$MACOS_X86"
      echo "$MACOS_ARM"
      ;;
    MINGW*|MSYS*|CYGWIN*)
      echo "$WINDOWS_X86"
      ;;
  esac
}

# Base toolchain check — runs once before any target builds
check_base_prerequisites() {
  local missing=()

  # Rust toolchain
  if ! command -v rustup &>/dev/null || ! command -v cargo &>/dev/null; then
    echo "Rust toolchain not found."
    if [[ -n "$ASSUME_YES" ]]; then
      answer=y
    else
      read -rp "Install Rust via rustup now? [Y/n] " answer
    fi
    if [[ "${answer,,}" != "n" ]]; then
      curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
      # shellcheck disable=SC1091
      source "$HOME/.cargo/env"
    else
      echo "ERROR: Rust is required to build ast-grep." >&2
      return 1
    fi
  fi

  # C compiler + make — required by the cc crate for tree-sitter grammar
  # compilation. Not checked on Windows: the msvc target compiles C via cl.exe.
  case "$HOST_OS" in
    MINGW*|MSYS*|CYGWIN*) ;;
    *)
      if ! command -v cc &>/dev/null && ! command -v gcc &>/dev/null && ! command -v clang &>/dev/null; then
        missing+=(build-essential)
      fi
      if ! command -v make &>/dev/null; then
        missing+=(make)
      fi
      ;;
  esac

  if [[ ${#missing[@]} -gt 0 ]]; then
    case "$HOST_OS" in
      Linux)
        echo "Installing base build dependencies: ${missing[*]}..."
        apt_install "${missing[@]}"
        ;;
      Darwin)
        if ! xcode-select -p &>/dev/null; then
          echo "Installing Xcode command line tools..."
          xcode-select --install
        fi
        ;;
      *)
        echo "ERROR: missing build dependencies: ${missing[*]}" >&2
        return 1
        ;;
    esac
  fi
}

# Per-target prerequisites — rustup target + target-specific toolchain
check_target_prerequisites() {
  local target="$1"

  if ! rustup target list --installed | grep -q "$target"; then
    echo "Installing rustup target $target..."
    rustup target add "$target"
  fi

  case "$target" in
    "$LINUX_X86")
      if ! command -v musl-gcc &>/dev/null; then
        echo "Installing musl-tools..."
        apt_install musl-tools
      fi
      ;;
    "$LINUX_ARM")
      if [[ "$HOST_ARCH" == "aarch64" ]]; then
        # Native build (arm64 host) — same musl-tools path as x86_64
        if ! command -v musl-gcc &>/dev/null; then
          echo "Installing musl-tools..."
          apt_install musl-tools
        fi
      elif ! command -v "$MUSL_CROSS_GCC" &>/dev/null \
        && [[ ! -x "$TOOLCHAIN_DIR/$MUSL_CROSS_NAME/bin/$MUSL_CROSS_GCC" ]]; then
        echo "Downloading $MUSL_CROSS_NAME toolchain..."
        mkdir -p "$TOOLCHAIN_DIR"
        curl -fsSL "$MUSL_CROSS_BASE_URL/$MUSL_CROSS_NAME.tgz" | tar -xz -C "$TOOLCHAIN_DIR"
      fi
      ;;
  esac
}

build_target() {
  local target="$1"
  echo "==> Building for $target"
  check_target_prerequisites "$target"

  local cargo_args=(
    build --release
    --target "$target"
    --manifest-path "$AST_GREP_DIR/Cargo.toml"
    -p ast-grep
  )

  # musl targets on linux: point the cc crate (tree-sitter C compilation) and
  # cargo's linker at a musl toolchain
  if [[ "$target" == "$LINUX_X86" && "$HOST_OS" == "Linux" ]]; then
    CC=musl-gcc cargo "${cargo_args[@]}"
  elif [[ "$target" == "$LINUX_ARM" && "$HOST_OS" == "Linux" && "$HOST_ARCH" == "aarch64" ]]; then
    CC=musl-gcc cargo "${cargo_args[@]}"
  elif [[ "$target" == "$LINUX_ARM" && "$HOST_OS" == "Linux" ]]; then
    local cross_gcc="$MUSL_CROSS_GCC"
    command -v "$cross_gcc" &>/dev/null || cross_gcc="$TOOLCHAIN_DIR/$MUSL_CROSS_NAME/bin/$MUSL_CROSS_GCC"
    CC="$cross_gcc" \
      CARGO_TARGET_AARCH64_UNKNOWN_LINUX_MUSL_LINKER="$cross_gcc" \
      cargo "${cargo_args[@]}"
  elif [[ "$target" == "$WINDOWS_X86" ]]; then
    # help text promises a static CRT; rustc only delivers it when asked
    RUSTFLAGS="${RUSTFLAGS:-} -C target-feature=+crt-static" cargo "${cargo_args[@]}"
  else
    cargo "${cargo_args[@]}"
  fi

  # Verify static linkage on Linux
  local binary_dir="$AST_GREP_DIR/target/$target/release"
  if [[ "$target" == *-linux-musl ]]; then
    local binary="$binary_dir/ast-grep"
    if file "$binary" | grep -qE "static(ally|-pie) linked"; then
      echo "    ✓ Verified: statically linked"
    else
      echo "    ⚠ Warning: binary may not be fully static" >&2
      file "$binary"
    fi
  fi

  echo "    Output: $binary_dir/"
}

# --- Main ---

targets=()

# --yes may appear alongside targets; strip it before target parsing
args=()
for arg in "$@"; do
  case "$arg" in
    -y|--yes) ASSUME_YES=1 ;;
    *) args+=("$arg") ;;
  esac
done
set -- ${args[@]+"${args[@]}"}

if [[ $# -eq 0 ]]; then
  targets+=("$(native_target)")
elif [[ "$1" == "--all" ]]; then
  mapfile -t targets < <(feasible_targets)
elif [[ "$1" == "--list" ]]; then
  echo "All release targets:"
  printf '  %s\n' "${ALL_TARGETS[@]}"
  echo ""
  echo "Feasible on this host:"
  feasible_targets | sed 's/^/  /'
  exit 0
elif [[ "$1" == "-h" || "$1" == "--help" ]]; then
  cat <<EOF
Usage: bin/build-static [OPTIONS] [TARGET...]

Build statically-linked ast-grep binaries.

Options:
  (none)      Build for the current platform
  --all       Build all targets feasible on this host
  --list      Show available and feasible targets
  -y, --yes   Non-interactive: assume yes for prompts and package installs
              (implied when the CI environment variable is set)
  -h, --help  Show this help

Targets:
  x86_64-unknown-linux-musl     Linux x86_64 (fully static via musl)
  aarch64-unknown-linux-musl    Linux aarch64 (fully static via musl)
  x86_64-apple-darwin           macOS x86_64
  aarch64-apple-darwin          macOS aarch64 (Apple Silicon)
  x86_64-pc-windows-msvc        Windows x86_64 (static CRT)

Prerequisites (auto-installed if missing):
  Base:
    rustup + cargo              Rust toolchain
    build-essential (gcc, make) C compiler for tree-sitter grammars
  Linux targets:
    musl-tools                  For x86_64-unknown-linux-musl
    aarch64-linux-musl-cross    For aarch64-unknown-linux-musl (fetched from
                                musl.cc into .toolchains/ if not on PATH)
  macOS:
    Xcode command line tools    Provides clang + make
EOF
  exit 0
else
  targets=("$@")
fi

echo "Building ast-grep static binaries"
echo "Targets: ${targets[*]}"
echo ""

check_base_prerequisites

for target in "${targets[@]}"; do
  build_target "$target"
  echo ""
done

echo "Done. Run 'bin/package-release' to create distributable archives."
